#!/bin/bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if ! grep -qxF 'defaults.properties' backend/.gitignore; then
    echo "ERROR: backend/defaults.properties must be ignored before committing." >&2
    exit 1
fi

staged_config=$(git diff --cached --name-only --diff-filter=ACMR -- backend/defaults.properties)
if [ -n "$staged_config" ]; then
    echo "ERROR: backend/defaults.properties must not be committed. Unstage it before retrying." >&2
    exit 1
fi

echo "Running backend ktlintCheck..."
if ./backend/gradlew -p backend ktlintCheck; then
    echo "Ktlint: no violations found."
else
    echo "ERROR: ktlintCheck failed. Fix any build errors or run:" >&2
    echo "  ./backend/gradlew -p backend ktlintFormat" >&2
    echo "Then review and stage the changes yourself before retrying." >&2
    exit 1
fi
